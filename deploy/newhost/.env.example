# Kopieren nach deploy/newhost/.env und ausfuellen. Diese Datei NIE committen und nicht ueber GitHub verschicken.
# Passwoerter z. B. mit:  openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=
HVV_RO_PASSWORD=

# RAM und Kerne, die die Datenbank nutzen darf (timescaledb-tune stellt Puffer und Worker danach ein)
DB_MEMORY=4GB
DB_CPUS=4

# GitHub: privates Repo, dessen Releases die Datenpakete tragen (owner/name) und ein Token mit Lesezugriff auf Contents
# (fine-grained Personal Access Token, nur dieses Repo, "Contents: Read-only")
GITHUB_REPO=OCISLY-ds/hvv-gti
GITHUB_TOKEN=
HVV_IMPORT_INTERVAL=300

# Geofox-GTI: dieselben Zugangsdaten wie auf dem Pi (der Planer fragt Abfahrten und Routen selbst ab). Der Account teilt sich das Limit von
# 1 Aufruf pro Sekunde mit dem Sammler auf dem Pi (ca. 0,2 Aufrufe/s): HVV_MIN_REQUEST_INTERVAL nicht senken.
HVV_GTI_USER=
HVV_GTI_PASSWORD=
HVV_GTI_BASE_URL=https://gti.geofox.de
HVV_API_VERSION=63
HVV_MIN_REQUEST_INTERVAL=1.2

# Cloudflare-Tunnel (Profil "tunnel"), Token aus dem Cloudflare-Dashboard
TUNNEL_TOKEN=
