          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"hvv_train_stop\")\n  |> filter(fn: (r) => contains(value: r.line, set: ${line:json}) and contains(value: r.direction, set: ${direction:json}))\n  |> filter(fn: (r) => r._field == \"actual\" or r._field == \"idx\" or r._field == \"train\")\n  |> pivot(rowKey: [\"_time\", \"journey\", \"line\", \"direction\", \"station\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> map(fn: (r) => ({_time: time(v: r.actual * 1000000000), _value: r.idx, train: r.train + \" \" + r.direction}))\n  |> group(columns: [\"train\"])\n  |> sort(columns: [\"_time\"])"
