          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"hvv_api_request\" and r._field == \"latency_ms\")\n  |> group()\n  |> count()\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
