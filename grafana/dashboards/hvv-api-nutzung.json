    },
    {
      "id": 10,
      "type": "table",
      "title": "Aufrufe je Endpunkt",
      "datasource": {
        "type": "influxdb",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"hvv_api_request\" and (r._field == \"latency_ms\" or r._field == \"bytes\"))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group(columns: [\"endpoint\"])\n  |> reduce(\n      identity: {n: 0, err: 0, lat: 0.0, size: 0.0},\n      fn: (r, accumulator) => ({\n        n: accumulator.n + 1,\n        err: accumulator.err + (if r.status == \"ok\" then 0 else 1),\n        lat: accumulator.lat + float(v: r.latency_ms),\n        size: accumulator.size + float(v: r.bytes)\n      })\n  )\n  |> group()\n  |> map(fn: (r) => ({\n      Endpunkt: r.endpoint,\n      Anfragen: r.n,\n      \"Ø Latenz\": r.lat / float(v: r.n),\n      \"Ø Antwort\": r.size / float(v: r.n) / 1024.0,\n      Fehler: r.err\n  }))\n  |> sort(columns: [\"Anfragen\"], desc: true)\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Ø Latenz"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Ø Antwort"
            },
            "properties": [
              {
                "id": "unit",
                "value": "kbytes"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Anfragen"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fehler"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
