    {
      "id": 7,
      "type": "timeseries",
      "title": "Anfragen pro Sekunde",
      "datasource": {
        "type": "influxdb",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"hvv_api_request\" and r._field == \"latency_ms\")\n  |> group()\n  |> aggregateWindow(every: ${fenster}, fn: count, createEmpty: true)\n  |> map(fn: (r) => ({_time: r._time, _value: float(v: r._value) / (float(v: int(v: ${fenster})) / 1000000000.0)}))\n  |> rename(columns: {_value: \"Anfragen pro Sekunde\"})\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "description": "Aufrufe der HVV-Schnittstelle je Sekunde, gemittelt über das gewählte Fenster."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Anfragen pro Sekunde nach Endpunkt",
      "datasource": {
        "type": "influxdb",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"hvv_api_request\" and r._field == \"latency_ms\")\n  |> group(columns: [\"endpoint\"])\n  |> aggregateWindow(every: ${fenster}, fn: count, createEmpty: true)\n  |> map(fn: (r) => ({_time: r._time, endpoint: r.endpoint, _value: float(v: r._value) / (float(v: int(v: ${fenster})) / 1000000000.0)}))\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "min": 0,
          "displayName": "${__field.labels.endpoint}",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "description": "Gestapelt: welche GTI-Methoden die Last erzeugen."
    },
    {
