          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"hvv_api_request\" and r._field == \"latency_ms\")\n  |> group()\n  |> aggregateWindow(every: ${fenster}, fn: max, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> rename(columns: {_value: \"Max. Latenz\"})\n"
        }
      ],
      "fieldConfig": {
