{
  "uid": "hvv-api-nutzung",
  "title": "HVV API-Nutzung (Anfragen pro Sekunde)",
  "description": "Wie oft der Collector die Geofox-Schnittstelle (GTI) des HVV aufruft: Anfragen pro Sekunde, Latenz, Fehler und Aufrufe je Endpunkt.",
  "tags": [
    "hvv",
    "api",
    "oepnv"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "Europe/Berlin",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Datenquelle",
        "type": "datasource",
        "query": "influxdb",
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "HVV InfluxDB",
          "value": "hvv-influx"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "textbox",
        "query": "hvv",
        "current": {
          "text": "hvv",
          "value": "hvv"
        },
        "options": [
          {
            "selected": true,
            "text": "hvv",
            "value": "hvv"
          }
        ],
        "hide": 2
      },
      {
        "name": "fenster",
        "label": "Fenster",
        "type": "custom",
        "query": "1m,5m,15m,1h",
        "current": {
          "text": "5m",
          "value": "5m"
        },
        "options": [
          {
            "selected": false,
            "text": "1m",
            "value": "1m"
          },
          {
            "selected": true,
            "text": "5m",
            "value": "5m"
          },
          {
            "selected": false,
            "text": "15m",
            "value": "15m"
          },
          {
            "selected": false,
            "text": "1h",
            "value": "1h"
          }
        ],
        "hide": 0,
        "description": "Zeitfenster, über das die Anfragen pro Sekunde gemittelt werden. Ein Zyklus des Collectors dauert rund 100 Sekunden, darunter schwankt die Kurve stark."
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "HVV",
      "type": "link",
      "url": "https://www.hvv.de",
      "targetBlank": true,
      "icon": "external link"
    },
    {
      "title": "Pünktlichkeit S5, S7, X30, RE5, 234",
      "type": "link",
      "url": "/d/hvv-s5-puenktlichkeit",
      "icon": "dashboard"
    },
    {
      "title": "Netz S- und U-Bahn",
      "type": "link",
      "url": "/d/hvv-netz-s-u-bahn",
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Anfragen pro Sekunde (5 min)",
      "datasource": {
        "type": "influxdb",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"hvv_api_request\" and r._field == \"latency_ms\")\n  |> group()\n  |> count()\n  |> map(fn: (r) => ({_value: float(v: r._value) / 300.0}))\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^_value$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "description": "Mittel der letzten 5 Minuten, unabhängig vom gewählten Zeitraum."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Ø Anfragen pro Sekunde",
      "datasource": {
        "type": "influxdb",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"hvv_api_request\" and r._field == \"latency_ms\")\n  |> group()\n  |> reduce(identity: {n: 0, t0: 2100-01-01T00:00:00Z, t1: 1970-01-01T00:00:00Z}, fn: (r, accumulator) => ({\n      n: accumulator.n + 1,\n      t0: if r._time < accumulator.t0 then r._time else accumulator.t0,\n      t1: if r._time > accumulator.t1 then r._time else accumulator.t1\n  }))\n  |> map(fn: (r) => ({_value: if r.n > 1 and r.t1 > r.t0 then float(v: r.n - 1) / (float(v: int(v: r.t1) - int(v: r.t0)) / 1000000000.0) else 0.0}))\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^_value$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "description": "Aufrufe im gewählten Zeitraum geteilt durch die Zeit zwischen erstem und letztem Aufruf."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Anteil am Limit",
      "datasource": {
        "type": "influxdb",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"hvv_api_request\" and r._field == \"latency_ms\")\n  |> group()\n  |> count()\n  |> map(fn: (r) => ({_value: float(v: r._value) / 300.0 * 100.0}))\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^_value$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "description": "Letzte 5 Minuten im Verhältnis zu einem Aufruf pro Sekunde."
    },
