# Kopieren nach .env und ausfuellen:  cp .env.example .env
# Kommentare stehen bewusst in eigenen Zeilen (docker compose und der eigene Parser).

# --- Geofox GTI (HVV) -------------------------------------------------------
# Zugang (Application-ID + Passwort) per Mail an api@hochbahn.de anfragen.
HVV_GTI_USER=
HVV_GTI_PASSWORD=
HVV_GTI_BASE_URL=https://gti.geofox.de
HVV_API_VERSION=63
# Mindestabstand zwischen zwei API-Aufrufen in Sekunden. Die GTI sperrt Accounts
# voruebergehend, die im Schnitt mehr als 1 Aufruf pro Sekunde machen.
HVV_MIN_REQUEST_INTERVAL=1.2

# --- Puenktlichkeits-Collector ---------------------------------------------
# Die ausgewerteten Strecken (S5, S7, X30, RE5, 234) und ihre Haltestellen stehen fest in
# hvv_gti/config.py (ROUTES), ebenso das S- und U-Bahn-Netz (NETWORK), nicht hier.
# Pause zwischen zwei Zyklen in Sekunden. Ein Zyklus sind rund 11 GTI-Aufrufe nacheinander (je ~3 s Antwortzeit, also rund 35 s),
# das ergibt im Schnitt ca. 0,12 Aufrufe pro Sekunde (siehe Dashboard HVV API-Nutzung).
HVV_POLL_INTERVAL=60
HVV_MAX_TIME_OFFSET=30
# Abstand der Stoerungsmeldungs-Abfrage (getAnnouncements, ~75 KB) in Sekunden, 0 = aus.
HVV_ANNOUNCEMENT_INTERVAL=300

# --- InfluxDB (iot-stack) ---------------------------------------------------
# Collector im Docker-Host-Netz: localhost. Grafana erreicht Influx im iot-stack als http://influxdb:8086.
INFLUX_URL=http://localhost:8086
INFLUX_ORG=Bergedorf
INFLUX_BUCKET=hvv
# Token mit Schreibrecht auf den Bucket (fuer Grafana separat einen Lese-Token verwenden).
INFLUX_TOKEN=
